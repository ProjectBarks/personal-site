---
// src/components/RedirectStub.astro
// A page served at a post's former slug. It exists for two readers: browsers,
// which follow the meta refresh, and link previewers (slack, imessage), which
// read the og tags off this very url and never follow the refresh — so the
// stub carries the post's full unfurl card, not just a redirect.
import resume from '../data/resume.json';
import { deEm } from '../lib/text';

interface Props {
  title: string;
  description: string;
  toPath: string; // site-relative path of the current slug
  ogImage?: string; // site-relative path, made absolute here
}
const { title, description, toPath, ogImage } = Astro.props;
const canonical = new URL(toPath, resume.meta.url).href;
const image = ogImage ? new URL(ogImage, resume.meta.url).href : undefined;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{deEm(title)}</title>
  <link rel="canonical" href={canonical} />
  <meta http-equiv="refresh" content={`0;url=${toPath}`} />
  <meta name="description" content={deEm(description)} />
  <meta property="og:site_name" content={resume.name} />
  <meta property="og:title" content={deEm(title)} />
  <meta property="og:description" content={deEm(description)} />
  <meta property="og:type" content="article" />
  <meta property="og:url" content={canonical} />
  {image && <meta property="og:image" content={image} />}
  {image && <meta property="og:image:width" content="1200" />}
  {image && <meta property="og:image:height" content="630" />}
  <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={deEm(title)} />
  <meta name="twitter:description" content={deEm(description)} />
  {image && <meta name="twitter:image" content={image} />}
</head>
<body>
  <p>moved to <a href={toPath}>{canonical}</a></p>
</body>
</html>
