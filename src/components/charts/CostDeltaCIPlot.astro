---
// The same cost-delta chart as CostDeltaCI.astro, drawn by Observable Plot and
// serialised to SVG at build time. Nothing here reaches the browser: Plot and
// jsdom run during `astro build` and only the resulting markup is emitted.
//
// Rendered at two widths and swapped with a media query, because Plot emits a
// viewBox and a viewBox scales label text down with the chart. Two static
// renders keep 11px labels at 11px on a phone without any client script.
import * as Plot from '@observablehq/plot';
import { JSDOM } from 'jsdom';
import { arms, domain, band, money } from './costDeltaData.js';

const hue = (d) => (d.role === 'control' ? 'var(--chart-grey)' : 'var(--accent)');

function render(width) {
  const { document } = new JSDOM('').window;
  const chart = Plot.plot({
    document,
    width,
    height: 210,
    marginTop: 26,
    marginBottom: 46,
    marginLeft: 74,
    marginRight: 14,
    style: { background: 'transparent', fontSize: '11px' },
    x: {
      domain,
      label: null,
      grid: false,
      tickFormat: (t) => (t < 0 ? `-$${Math.abs(t)}` : t === 0 ? '$0' : `+$${t}`),
      ticks: [-1, 0, 1, 2],
    },
    y: { domain: arms.map((a) => a.label), label: null, padding: 0.55 },
    marks: [
      // the A/A control's own interval, drawn as context rather than a series
      Plot.rectX([{ x1: band[0], x2: band[1] }], {
        x1: 'x1',
        x2: 'x2',
        fill: 'var(--chart-band)',
      }),
      Plot.ruleX([band[0], band[1]], { stroke: 'var(--rule)', strokeWidth: 1 }),
      Plot.ruleX([0], { stroke: 'var(--dim)', strokeWidth: 1 }),

      Plot.ruleY(arms, {
        y: 'label',
        x1: (d) => d.ci[0],
        x2: (d) => d.ci[1],
        stroke: hue,
        strokeWidth: 2,
      }),
      Plot.tickX(arms, { y: 'label', x: (d) => d.ci[0], stroke: hue, strokeWidth: 1.5 }),
      Plot.tickX(arms, { y: 'label', x: (d) => d.ci[1], stroke: hue, strokeWidth: 1.5 }),
      Plot.tickX(arms, { y: 'label', x: 'median', stroke: hue, strokeWidth: 3 }),
      Plot.dot(arms, {
        y: 'label',
        x: 'mean',
        fill: hue,
        stroke: 'var(--bg)',
        strokeWidth: 2,
        r: 5,
      }),
      Plot.text(arms, {
        y: 'label',
        x: 'mean',
        text: (d) => money(d.mean),
        dy: -16,
        fill: 'var(--ink)',
        fontSize: 12,
      }),
      Plot.text(arms, {
        y: 'label',
        x: 'median',
        text: (d) => `median ${money(d.median)}`,
        dy: 22,
        fill: 'var(--muted)',
        fontSize: 11,
      }),
      Plot.text(['pricier with headroom'], {
        frameAnchor: 'bottom-left',
        textAnchor: 'start',
        dy: 34,
        fill: 'var(--muted)',
        fontSize: 11,
      }),
      Plot.text(['cheaper with headroom'], {
        frameAnchor: 'bottom-right',
        textAnchor: 'end',
        dy: 34,
        fill: 'var(--muted)',
        fontSize: 11,
      }),
    ],
  });
  chart.removeAttribute('width');
  chart.setAttribute('role', 'img');
  chart.setAttribute('aria-label', ariaLabel);
  return chart.outerHTML;
}

const ariaLabel =
  "The treatment's mean cost saving of $0.367 per task sits inside the A/A control's own 95% confidence interval, and both intervals straddle zero.";

const wide = render(700);
const narrow = render(380);
---

<figure class="fig fig-plot">
  <p class="fig-head">mean per-task cost delta, off minus on</p>
  <p class="fig-sub">dot is the mean, bar is the median, line is the 95% bootstrap CI</p>
  <div class="fig-key">
    <span>
      <svg width="26" height="10" aria-hidden="true"><rect class="band" x="0" y="0" width="26" height="10"/><line class="grid" x1="0.5" x2="0.5" y1="0" y2="10"/><line class="grid" x1="25.5" x2="25.5" y1="0" y2="10"/></svg>
      A/A control noise band
    </span>
    <span>
      <svg width="26" height="10" aria-hidden="true"><line class="s-grey" x1="1" x2="25" y1="5" y2="5" stroke-width="2"/><circle class="m-grey ring" cx="13" cy="5" r="4"/></svg>
      on-cache, control
    </span>
    <span>
      <svg width="26" height="10" aria-hidden="true"><line class="s-blue" x1="1" x2="25" y1="5" y2="5" stroke-width="2"/><circle class="m-blue ring" cx="13" cy="5" r="4"/></svg>
      on-token, treatment
    </span>
  </div>
  <div class="plot-wide" set:html={wide} />
  <div class="plot-narrow" set:html={narrow} />
  <div class="fig-stats">
    {arms.map((a) => (
      <div>
        <b>{a.label}, {a.role === 'control' ? 'A/A control' : 'treatment'}</b> n <i>{a.n}</i>
        &middot; Wilcoxon p <i>{a.p}</i> &middot; Cohen's dz <i>{a.dz}</i> &middot;
        <i>{a.cheaper}</i> cheaper / <i>{a.pricier}</i> pricier
      </div>
    ))}
  </div>
  <figcaption>
    Running the identical configuration twice, which is what the control arm is, already produces an
    apparent saving of <b>$0.730</b> per task. The treatment's <b>$0.367</b> lands inside that band, its
    median is <b>negative</b>, and more of its tasks came out pricier than cheaper. There is no effect
    here to measure.
  </figcaption>
</figure>
