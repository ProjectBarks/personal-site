---
// src/pages/index.astro
import Base from '../layouts/Base.astro';
import WritingList from '../components/WritingList.astro';
import resume from '../data/resume.json';
import { deEm, hardenLinks } from '../lib/text';

const lede = hardenLinks(
  deEm(resume.lede_html.replace(/\s*innovating for the future[^.]*\.\s*$/i, '').trim()).replace(
    /href="#/g,
    'href="/cv#'
  )
);
---
<Base active="home" title={resume.meta.title} ogUrl={resume.meta.url} cmd="whoami">
  <h1 class="name">{resume.name.toLowerCase()}</h1>
  <pre class="ascii" aria-hidden="true">{resume.ascii}</pre>
  <p class="lede" set:html={lede} />
  <hr />
  <WritingList />
</Base>
